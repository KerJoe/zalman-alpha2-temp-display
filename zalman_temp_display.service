[Unit]
Description=Zalman Alpha2 A24 Temperature Display Driver
After=local-fs.target

[Service]
Type=simple
# If not using .socket service, creates FIFO manually
ExecStartPre=-/usr/bin/mkfifo /run/zalman_temp_display.fifo
StandardInput=file:/run/zalman_temp_display.fifo
ExecStart=/usr/local/bin/zalman_temp_display
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
